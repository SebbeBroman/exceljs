{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "strict": true,
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "noImplicitOverride": false
  },
  "include": ["test/**/*.ts", "lib/**/*.ts", "excel.ts", "index.d.ts"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "test/regression"
  ]
}
