{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowJs": false,
    "checkJs": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["lib/**/*.ts", "lib/**/*.d.ts", "excel.ts"],
  "exclude": ["node_modules", "build", "dist", "spec", "test", "scripts"]
}
