{
  "name": "exceljs",
  "version": "4.5.0-esm.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files. (ESM / tree-shakeable fork)",
  "private": false,
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exceljs/exceljs.git"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./excel.js",
  "module": "./excel.js",
  "types": "./index.d.ts",
  "browser": {
    "fs": "./lib/shims/fs-browser.js",
    "crypto": "./lib/shims/crypto-browser.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./excel.js",
      "import": "./excel.js",
      "default": "./excel.js"
    },
    "./csv": {
      "types": "./index.d.ts",
      "import": "./lib/csv-entry.js",
      "default": "./lib/csv-entry.js"
    },
    "./stream/xlsx": {
      "types": "./index.d.ts",
      "import": "./lib/stream-xlsx-entry.js",
      "default": "./lib/stream-xlsx-entry.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./lib/csv-entry.js"
  ],
  "files": [
    "lib",
    "excel.js",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "index.ts",
    "index.d.ts",
    "ESM.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run spec/unit",
    "test:integration": "vitest run spec/integration",
    "test:esm": "node scripts/smoke-esm.mjs",
    "test:browser-bundle": "node scripts/smoke-browser-bundle.mjs",
    "lint": "eslint --format node_modules/eslint-friendly-formatter .",
    "convert:esm": "node scripts/cjs-to-esm.mjs"
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "esm",
    "tree-shaking",
    "spreadsheet",
    "workbook"
  ],
  "dependencies": {
    "dayjs": "^1.8.34",
    "fast-csv": "^5.0.7",
    "fflate": "^0.8.2",
    "saxes": "^6.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "jszip": "^3.10.1",
    "vitest": "^3.2.7"
  }
}
