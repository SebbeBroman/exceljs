{
  "name": "exceljs",
  "version": "4.5.0-esm.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files. (ESM / tree-shakeable fork)",
  "private": false,
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exceljs/exceljs.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "main": "./dist/excel.js",
  "module": "./dist/excel.js",
  "types": "./index.d.ts",
  "browser": {
    "fs": "./dist/lib/shims/fs-browser.js",
    "crypto": "./dist/lib/shims/crypto-browser.js",
    "node:module": "./dist/lib/shims/node-module-browser.js",
    "module": "./dist/lib/shims/node-module-browser.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./dist/excel.js",
      "import": "./dist/excel.js",
      "default": "./dist/excel.js"
    },
    "./csv": {
      "types": "./index.d.ts",
      "import": "./dist/lib/csv-entry.js",
      "default": "./dist/lib/csv-entry.js"
    },
    "./stream/xlsx": {
      "types": "./index.d.ts",
      "import": "./dist/lib/stream-xlsx-entry.js",
      "default": "./dist/lib/stream-xlsx-entry.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/lib/csv-entry.js",
    "./lib/csv-entry.ts"
  ],
  "files": [
    "dist",
    "lib",
    "excel.ts",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "index.d.ts",
    "ESM.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:unit": "vp test run spec/unit",
    "test:integration": "vp test run spec/integration",
    "test:esm": "pnpm build && node scripts/smoke-esm.mjs",
    "test:browser-bundle": "pnpm build && node scripts/smoke-browser-bundle.mjs",
    "check": "vp check",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "benchmark": "node --expose-gc benchmark.js",
    "prepare": "vp config",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "esm",
    "tree-shaking",
    "spreadsheet",
    "workbook",
    "typescript"
  ],
  "dependencies": {
    "dayjs": "^1.8.34",
    "fast-csv": "^5.0.7",
    "fflate": "^0.8.2",
    "saxen": "^11.1.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.8",
    "jszip": "^3.10.1",
    "typescript": "~5.8.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
