{
  "name": "@sebbebroman/excel-ts",
  "version": "4.5.0",
  "description": "Read and write Excel workbooks (xlsx/csv). ESM TypeScript fork of ExcelJS for modern bundlers.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "SebbeBroman",
    "url": "https://github.com/SebbeBroman"
  },
  "contributors": [
    {
      "name": "Guyon Roche",
      "email": "guyon@live.com"
    },
    {
      "name": "ExcelJS contributors"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebbeBroman/excel-ts.git"
  },
  "homepage": "https://github.com/SebbeBroman/excel-ts#readme",
  "bugs": {
    "url": "https://github.com/SebbeBroman/excel-ts/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "main": "./dist/excel.js",
  "module": "./dist/excel.js",
  "types": "./index.d.ts",
  "browser": {
    "fs": "./dist/lib/shims/fs-browser.js",
    "node:module": "./dist/lib/shims/node-module-browser.js",
    "module": "./dist/lib/shims/node-module-browser.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./dist/excel.js",
      "import": "./dist/excel.js",
      "default": "./dist/excel.js"
    },
    "./csv": {
      "types": "./index.d.ts",
      "import": "./dist/lib/csv-entry.js",
      "default": "./dist/lib/csv-entry.js"
    },
    "./stream/xlsx": {
      "types": "./index.d.ts",
      "import": "./dist/lib/stream-xlsx-entry.js",
      "default": "./dist/lib/stream-xlsx-entry.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/lib/csv-entry.js",
    "./lib/csv-entry.ts"
  ],
  "files": [
    "dist",
    "lib",
    "excel.ts",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "index.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:unit": "vp test run spec/unit",
    "test:integration": "vp test run spec/integration",
    "test:esm": "pnpm build && node scripts/smoke-esm.mjs",
    "test:browser-bundle": "pnpm build && node scripts/smoke-browser-bundle.mjs",
    "check": "vp check",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "benchmark": "node --expose-gc benchmark.js",
    "prepare": "vp config",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "keywords": [
    "xlsx",
    "excel",
    "csv",
    "spreadsheet",
    "workbook",
    "typescript",
    "esm",
    "tree-shaking",
    "exceljs"
  ],
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "dayjs": "^1.8.34",
    "fast-csv": "^5.0.7",
    "fflate": "^0.8.2",
    "saxen": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.1",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
