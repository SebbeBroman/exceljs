{
  "name": "@sebbebroman/exceljs",
  "version": "0.2.0",
  "description": "Builder-first Excel (xlsx) for modern bundlers. ESM TypeScript fork of ExcelJS.",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "author": {
    "name": "SebbeBroman",
    "url": "https://github.com/SebbeBroman"
  },
  "contributors": [
    {
      "name": "Guyon Roche",
      "email": "guyon@live.com"
    },
    {
      "name": "ExcelJS contributors"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebbeBroman/exceljs.git"
  },
  "homepage": "https://github.com/SebbeBroman/exceljs#readme",
  "bugs": {
    "url": "https://github.com/SebbeBroman/exceljs/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/excel.js",
  "module": "./dist/excel.js",
  "types": "./excel.d.ts",
  "browser": {
    "fs": "./dist/lib/shims/fs-browser.js",
    "node:module": "./dist/lib/shims/node-module-browser.js",
    "module": "./dist/lib/shims/node-module-browser.js"
  },
  "exports": {
    ".": {
      "types": "./excel.d.ts",
      "browser": "./dist/excel.js",
      "import": "./dist/excel.js",
      "default": "./dist/excel.js"
    },
    "./node": {
      "types": "./node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json",
    "./protection": {
      "types": "./protection.d.ts",
      "import": "./dist/protection.js",
      "default": "./dist/protection.js"
    },
    "./csv": {
      "types": "./csv.d.ts",
      "import": "./dist/csv.js",
      "default": "./dist/csv.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "excel.d.ts",
    "node.d.ts",
    "protection.d.ts",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "MIGRATION.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "csv.d.ts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:public": "node scripts/check-public-types.mjs",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:unit": "vp test run spec/unit",
    "test:integration": "vp test run spec/integration",
    "test:esm": "pnpm build && node scripts/smoke-esm.mjs",
    "test:browser-bundle": "pnpm build && node scripts/smoke-browser-bundle.mjs",
    "check:asset-size": "node scripts/check-asset-size.mjs",
    "check": "vp check",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "bench": "pnpm build && node --expose-gc scripts/bench/e2e.mjs",
    "bench:write": "pnpm build && node --expose-gc scripts/bench/e2e.mjs --filter write",
    "bench:read": "pnpm build && node --expose-gc scripts/bench/e2e.mjs --filter read",
    "bench:roundtrip": "pnpm build && node --expose-gc scripts/bench/e2e.mjs --filter roundtrip",
    "bench:dense": "pnpm build && node --expose-gc scripts/bench-dense-write.mjs",
    "bench:browser": "pnpm build && node scripts/bench/browser.mjs",
    "bench:view": "pnpm build && node --expose-gc scripts/bench/read.mjs",
    "prepare": "vp config",
    "prepublishOnly": "pnpm check && pnpm test && pnpm typecheck && pnpm typecheck:spec && pnpm typecheck:public && pnpm build && pnpm run test:esm && pnpm run test:browser-bundle && pnpm check:asset-size",
    "release": "pnpm publish --access public"
  },
  "keywords": [
    "xlsx",
    "excel",
    "csv",
    "spreadsheet",
    "workbook",
    "typescript",
    "esm",
    "tree-shaking",
    "exceljs"
  ],
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "dayjs": "1.11.21",
    "fflate": "0.8.3",
    "saxen": "11.1.1",
    "@sebbebroman/fast-csv": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.1",
    "exceljs": "^4.4.0",
    "mitata": "^1.0.34",
    "puppeteer-core": "^25.4.0",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "0.2.7"
  },
  "packageManager": "pnpm@11.20.0"
}
