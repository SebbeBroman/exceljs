{
  "name": "exceljs",
  "version": "4.5.0-esm.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files. (ESM / tree-shakeable fork)",
  "private": false,
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exceljs/exceljs.git"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./excel.js",
  "module": "./excel.js",
  "types": "./index.d.ts",
  "browser": {
    "fs": "./lib/shims/fs-browser.js",
    "crypto": "./lib/shims/crypto-browser.js",
    "tmp": "./lib/shims/empty.js",
    "archiver": "./lib/shims/empty.js",
    "unzipper": "./lib/shims/empty.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": "./excel.js",
      "import": "./excel.js",
      "default": "./excel.js"
    },
    "./csv": {
      "types": "./index.d.ts",
      "import": "./lib/csv-entry.js",
      "default": "./lib/csv-entry.js"
    },
    "./stream/xlsx": {
      "types": "./index.d.ts",
      "import": "./lib/stream-xlsx-entry.js",
      "default": "./lib/stream-xlsx-entry.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./lib/csv-entry.js"
  ],
  "files": [
    "lib",
    "excel.js",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "index.ts",
    "index.d.ts",
    "ESM.md"
  ],
  "scripts": {
    "test:esm": "node scripts/smoke-esm.mjs",
    "test:browser-bundle": "node scripts/smoke-browser-bundle.mjs",
    "test:unit": "mocha --require spec/config/setup --require spec/config/setup-unit spec/unit --recursive",
    "test:integration": "mocha --require spec/config/setup spec/integration --recursive",
    "lint": "eslint --format node_modules/eslint-friendly-formatter .",
    "convert:esm": "node scripts/cjs-to-esm.mjs"
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "esm",
    "tree-shaking",
    "spreadsheet",
    "workbook"
  ],
  "dependencies": {
    "archiver": "^5.0.0",
    "buffer": "^6.0.3",
    "dayjs": "^1.8.34",
    "events": "^3.3.0",
    "fast-csv": "^4.3.1",
    "fflate": "^0.8.2",
    "readable-stream": "^3.6.0",
    "saxes": "^5.0.1",
    "tmp": "^0.2.0",
    "unzipper": "^0.10.11",
    "uuid": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "chai": "^4.2.0",
    "mocha": "^10.2.0"
  }
}
